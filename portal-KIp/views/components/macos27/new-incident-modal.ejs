<!-- ==================================================================== -->
<!-- BEGIN: Modal Sheet "NUEVO TICKET" (Diseño Nativo macOS 27 Dialog)    -->
<!-- Basado en: Dialogs/Small.txt, Forms/Form Row.txt, Text Fields,      -->
<!--            Pop-Up Button.txt, Buttons.txt                           -->
<!-- ==================================================================== -->
<div id="newIncidentModalOverlay"
    class="absolute inset-0 z-50 items-center justify-center transition-all duration-200 opacity-0 pointer-events-none hidden"
    style="background: rgba(0,0,0,0.35); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"
    onclick="handleNewIncidentBackdropClick(event)">

    <!-- macOS 27 Dialog Card (390px, border-radius: 16px, native shadow) -->
    <div id="newIncidentModalCard"
        class="macos-dialog select-none transform transition-all duration-200 scale-95 opacity-0"
        style="width: 390px;">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Top Section: Title + Description + Form Fields         -->
        <!-- Padding: 20px 40px (lateral), 20px top, 10px bottom   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <div style="display: flex; flex-direction: column; align-items: center; padding: 20px 24px 10px; gap: 6px; width: 100%;">

            <!-- Header Frame: Title + Description -->
            <div style="display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 0 0 8px; gap: 6px; width: 100%;">
                <!-- Title (Headline/Bold - font-size: 13px, font-weight: 700) -->
                <h3 style="width: 100%; font-weight: 700; font-size: 13px; line-height: 16px; color: rgba(0,0,0,0.85); margin: 0;">
                    Nuevo Ticket de Incidencia
                </h3>
                <!-- Description (Subheadline/Regular - font-size: 11px, font-weight: 400) -->
                <p style="width: 100%; font-weight: 400; font-size: 11px; line-height: 14px; color: rgba(0,0,0,0.85); margin: 0;">
                    Registra un nuevo ticket en la cola de despacho activa. Los campos marcados son requeridos para el seguimiento SLA.
                </p>
            </div>

            <!-- ═════════════════════════════════════════════ -->
            <!-- Form (macOS 27 native Form Container)        -->
            <!-- bg: rgba(0,0,0,0.03), border-radius: 12px   -->
            <!-- ═════════════════════════════════════════════ -->
            <form id="newIncidentForm" onsubmit="submitNewIncident(event)" class="macos-form" style="gap: 0;">

                <!-- Row 1: Asunto -->
                <div class="macos-form-row">
                    <div class="macos-form-row-label" style="min-width: 80px;">Asunto</div>
                    <div class="macos-form-row-content">
                        <input id="newIncSubject" required type="text"
                            class="macos-textfield"
                            placeholder="Ej. Intermitencia PON Nodo El Recreo">
                    </div>
                </div>

                <!-- Row 2: Área Técnica -->
                <div class="macos-form-row">
                    <div class="macos-form-row-label" style="min-width: 80px;">Área</div>
                    <div class="macos-form-row-content">
                        <select id="newIncArea" class="macos-popup-btn">
                            <option value="REDES_FTTH" selected>Redes FTTH</option>
                            <option value="GENERAL">Operaciones IP (General)</option>
                            <option value="WAN">WAN</option>
                            <option value="GRANDES_CLIENTES">Grandes Clientes</option>
                            <option value="TELEFONIA">Telefonía</option>
                            <option value="SEGURIDAD">Seguridad</option>
                            <option value="TRAFICO_INALAMBRICO">Tráfico</option>
                        </select>
                    </div>
                </div>

                <!-- Row 3: Prioridad SLA -->
                <div class="macos-form-row">
                    <div class="macos-form-row-label" style="min-width: 80px;">Prioridad</div>
                    <div class="macos-form-row-content">
                        <select id="newIncPriority" class="macos-popup-btn">
                            <option value="P1">P1 — Crítico (8 pts)</option>
                            <option value="P2" selected>P2 — Media (5 pts)</option>
                            <option value="P3">P3 — Normal (1 pto)</option>
                        </select>
                    </div>
                </div>

                <!-- Row 4: Operador (Opcional) -->
                <div class="macos-form-row">
                    <div class="macos-form-row-label" style="min-width: 80px;">Operador</div>
                    <div class="macos-form-row-content">
                        <select id="newIncOperator" class="macos-popup-btn">
                            <option value="">— Sin Asignar (Cola General)</option>
                            <% if (typeof operadores !== 'undefined' && operadores.length > 0) { %>
                                <% operadores.forEach(function(op) { %>
                                    <option value="<%= op.id %>"><%= op.nombre %> (<%= op.area_designada %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <!-- Row 5: Observaciones Técnicas -->
                <div class="macos-form-row" style="align-items: flex-start; padding-top: 8px; padding-bottom: 8px;">
                    <div class="macos-form-row-label" style="min-width: 80px; padding-top: 4px;">Notas</div>
                    <div class="macos-form-row-content">
                        <textarea id="newIncDescription" rows="3"
                            class="macos-textarea"
                            placeholder="Detalles sobre OLT, tarjetas o clientes afectados..."></textarea>
                    </div>
                </div>

            </form>
        </div>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Buttons Bar (macOS 27 native dialog button layout)     -->
        <!-- Padding: 12px 20px 20px, gap: 8px                     -->
        <!-- Pattern: [Cancel] — spacer — [Create (Default)]       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <div class="macos-dialog-buttons">
            <!-- Standard Button (Cancel) -->
            <button type="button" onclick="closeNewIncidentModal()" class="macos-btn-standard">
                Cancelar
            </button>

            <!-- Spacer -->
            <div style="flex: 1;"></div>

            <!-- Default Button (Blue Accent - Create) -->
            <button type="submit" id="submitNewIncidentBtn" form="newIncidentForm" class="macos-btn-default">
                Crear Ticket
            </button>
        </div>

    </div>
</div>
<!-- END: Modal Sheet "NUEVO TICKET" -->
