<!-- BEGIN: macOS Finder-style Sidebar Component -->
<aside class="w-[200px] flex-shrink-0 bg-[#EBEBF0]/95 border-r border-[#D8D8DC] flex flex-col justify-between select-none py-3 px-2">
    <div class="space-y-4">
        <div>
            <div class="px-2.5 pb-1.5 text-[10px] font-bold text-[#8E8E93] uppercase tracking-wider">
                Navegación
            </div>
            <nav class="space-y-0.5">
                <!-- Dashboard General (Activo) -->
                <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] bg-black/5 text-[#007AFF] font-medium text-[12px] transition cursor-pointer"
                    href="/">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#007AFF]" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.5V6a3 3 0 0 1 3-3h15a3 3 0 0 1 3 3v4.5">
                            </path>
                        </svg>
                        <span>Dashboard General</span>
                    </div>
                    <span class="font-mono text-[9px] bg-[#007AFF]/15 text-[#0062CC] px-1.5 py-0.5 rounded font-bold">
                        <%= typeof ticketsActivos !== 'undefined' ? ticketsActivos : 0 %>
                    </span>
                </a>

                <!-- Auditoría -->
                <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition cursor-pointer"
                    href="#" onclick="event.preventDefault(); showNotification('Módulo Auditoría', 'Visualizando registro de cambios y despachos', 'AUD');">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Auditoría</span>
                    </div>
                </a>

                <!-- Gestión de Turno -->
                <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition cursor-pointer"
                    href="#" onclick="event.preventDefault(); showNotification('Gestión de Turnos', 'Capacidad actual del turno: <%= operadoresDisponibles %>/<%= totalOperadores %>', 'TUR');">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                            </path>
                        </svg>
                        <span>Gestión de Turno</span>
                    </div>
                    <span class="font-mono text-[9px] bg-[#34C759]/15 text-[#34C759] px-1.5 py-0.5 rounded font-bold">
                        <%= typeof operadoresDisponibles !== 'undefined' ? operadoresDisponibles : 0 %>/<%= typeof totalOperadores !== 'undefined' ? totalOperadores : 0 %>
                    </span>
                </a>

                <!-- Reportes (Descarga CSV) -->
                <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition cursor-pointer"
                    href="/api/tickets/export" title="Exportar reporte de turno a CSV">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span>Exportar Reporte</span>
                    </div>
                    <span class="font-mono text-[9px] bg-[#8E8E93]/15 text-[#636366] px-1 py-0.5 rounded font-semibold">CSV</span>
                </a>
            </nav>
        </div>
    </div>

    <!-- Sidebar Bottom: Telemetría NOC en Vivo -->
    <div class="p-2.5 rounded-[8px] bg-white/70 border border-black/5 shadow-xs space-y-1">
        <div class="flex items-center justify-between text-[11px]">
            <span class="flex items-center gap-1.5 font-medium text-[#1C1C1E]">
                <span class="w-2 h-2 rounded-full bg-[#34C759] animate-pulse"></span>
                Servidor NOC
            </span>
            <span id="telemetryPing" class="font-mono text-[10px] text-[#34C759] font-bold">16ms</span>
        </div>
        <div class="flex items-center justify-between text-[10px] text-[#8E8E93] font-mono">
            <span>Sincronía OLT</span>
            <span class="text-[#3A3A3C]">Activo (0s)</span>
        </div>
    </div>
</aside>
<!-- END: Sidebar Component -->
