<!DOCTYPE html>
<html class="h-full bg-[#E8E8ED]" lang="es">

<head>
    <meta charset="utf-8">
    <meta content="width=1280, initial-scale=1.0" name="viewport">
    <title><%= titulo %></title>
    
    <!-- Tailwind CSS v3 with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- macOS 27 Component Design System -->
    <link rel="stylesheet" href="/css/macos27.css">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'Inter', 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', 'sans-serif'],
                        mono: ['SF Mono', 'JetBrains Mono', 'Menlo', 'Monaco', 'Courier New', 'monospace']
                    },
                    colors: {
                        mac: {
                            bg: '#F5F5F7', window: '#FFFFFF', sidebar: '#EBEBF0', accent: '#007AFF', accentHover: '#0062CC',
                            subtle: '#8E8E93', border: '#E5E5EA', borderLight: '#F2F2F7', headerBorder: '#D1D1D6',
                            selected: '#DCEBFE', selectedText: '#0062CC', dangerLight: '#FFE5E5', dangerText: '#D70015',
                            successLight: '#E3F9E5', successText: '#1B873F', warningLight: '#FFF4D6', warningText: '#B25E02'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            user-select: none;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .finder-th + .finder-th {
            border-left: 1px solid #E5E5EA;
        }
    </style>
</head>

<body class="h-screen w-screen bg-[#F5F5F7] overflow-hidden flex flex-col font-sans text-[13px] text-[#1C1C1E] m-0 p-0">

    <!-- macOS Full Application Viewport -->
    <div class="relative w-full h-full flex flex-col overflow-hidden bg-white select-none">

        <!-- Componente 1: Unified Titlebar & Toolbar -->
        <%- include('components/macos27/titlebar') %>

        <!-- Main Body Workspace -->
        <div class="flex-1 flex overflow-hidden min-h-0 bg-[#F5F5F7]">

            <!-- Componente 2: Finder-style macOS Sidebar -->
            <%- include('components/macos27/sidebar') %>

            <!-- Content Main Area -->
            <main class="flex-1 flex flex-col min-w-0 bg-white overflow-hidden p-3.5 gap-3">

                <!-- Componente 3: macOS 27 Liquid Glass KPI Cards -->
                <%- include('components/macos27/kpi-cards') %>

                <!-- Componente 4: Finder List View Table -->
                <%- include('components/macos27/finder-table') %>

            </main>
        </div>

        <!-- Componente 5: Modal Sheet de Asignación -->
        <%- include('components/macos27/assign-modal') %>

        <!-- Componente 6: Modal Sheet de Nuevo Ticket -->
        <%- include('components/macos27/new-incident-modal') %>

        <!-- Componente 7: Notificación Toast Liquid Glass -->
        <%- include('components/macos27/liquid-notification') %>

    </div>
    <!-- END: macOS Window Frame -->

    <!-- Interactive Client Scripts & Controller -->
    <script>
        let currentTicketCode = '';
        let currentOperatorInitials = 'CM';
        let notifTimeout = null;

        // ==========================================
        // 1. Control del Modal de Asignación
        // ==========================================
        function openAssignModal(ticketCode, subject, area, operatorId, operatorName, priority) {
            currentTicketCode = ticketCode;
            const overlay = document.getElementById('assignModalOverlay');
            const card = document.getElementById('assignModalCard');
            const ticketInput = document.getElementById('modalTicketInput');
            const subjectInput = document.getElementById('modalSubjectInput');
            const areaText = document.getElementById('modalAreaText');
            const areaValue = document.getElementById('selectedAreaValue');
            const opText = document.getElementById('modalOperatorText');
            const opIdInput = document.getElementById('selectedOperatorId');
            const unassignBtn = document.getElementById('modalUnassignBtn');

            if (ticketInput) ticketInput.value = ticketCode || '#INC-00000';
            if (subjectInput) subjectInput.value = subject || '';

            const areaLabels = {
                'REDES_FTTH': 'Redes FTTH',
                'GENERAL': 'Operaciones IP (General)',
                'WAN': 'WAN',
                'GRANDES_CLIENTES': 'Grandes Clientes',
                'TELEFONIA': 'Telefonía',
                'SEGURIDAD': 'Seguridad',
                'TRAFICO_INALAMBRICO': 'Tráfico'
            };
            const targetArea = area || 'REDES_FTTH';
            if (areaText) areaText.textContent = areaLabels[targetArea] || targetArea || 'Redes FTTH';
            if (areaValue) areaValue.value = targetArea;

            const p = (priority || 'P1').toUpperCase();
            const prioDot = document.getElementById('modalPriorityDot');
            const prioText = document.getElementById('modalPriorityText');
            const prioVal = document.getElementById('selectedPriorityValue');
            if (p === 'P1') {
                if (prioDot) prioDot.style.backgroundColor = '#FF3B30';
                if (prioText) prioText.textContent = 'P1 - Crítico';
                if (prioVal) prioVal.value = 'P1';
            } else if (p === 'P2') {
                if (prioDot) prioDot.style.backgroundColor = '#FFBD2E';
                if (prioText) prioText.textContent = 'P2 - Media';
                if (prioVal) prioVal.value = 'P2';
            } else {
                if (prioDot) prioDot.style.backgroundColor = '#8E8E93';
                if (prioText) prioText.textContent = 'P3 - Normal';
                if (prioVal) prioVal.value = 'P3';
            }

            if (opIdInput) opIdInput.value = operatorId || '';
            if (opText) {
                opText.textContent = operatorName || 'Seleccionar operador...';
                if (operatorName) {
                    let parts = operatorName.split(' ');
                    currentOperatorInitials = parts.length > 1 ? (parts[0][0] + parts[1][0]).toUpperCase() : operatorName.substring(0, 2).toUpperCase();
                } else {
                    currentOperatorInitials = 'OP';
                }
            }

            if (unassignBtn) {
                if (operatorId) unassignBtn.classList.remove('hidden');
                else unassignBtn.classList.add('hidden');
            }

            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            requestAnimationFrame(() => {
                overlay.classList.remove('opacity-0', 'pointer-events-none');
                overlay.classList.add('opacity-100');
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            });
        }

        function closeAssignModal() {
            const overlay = document.getElementById('assignModalOverlay');
            const card = document.getElementById('assignModalCard');
            if (!overlay || !card) return;

            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0', 'pointer-events-none');

            setTimeout(() => {
                overlay.classList.remove('flex');
                overlay.classList.add('hidden');
            }, 200);
        }

        function setModalArea(enumVal, label) {
            document.getElementById('modalAreaText').textContent = label;
            document.getElementById('selectedAreaValue').value = enumVal;
            const details = document.getElementById('modalAreaDropdown');
            if (details) details.removeAttribute('open');
        }

        function setModalPriority(prio, label, dotColor) {
            const prioText = document.getElementById('modalPriorityText');
            const prioVal = document.getElementById('selectedPriorityValue');
            const prioDot = document.getElementById('modalPriorityDot');
            if (prioText) prioText.textContent = label;
            if (prioVal) prioVal.value = prio;
            if (prioDot) prioDot.style.backgroundColor = dotColor;
            const details = document.getElementById('modalPriorityDropdown');
            if (details) details.removeAttribute('open');
        }

        function setModalOperator(operatorId, operatorName, initials) {
            document.getElementById('modalOperatorText').textContent = operatorName;
            document.getElementById('selectedOperatorId').value = operatorId;
            currentOperatorInitials = initials;
            const details = document.getElementById('modalOperatorDropdown');
            if (details) details.removeAttribute('open');
        }

        function showTicketSubjectAlert() {
            const subj = document.getElementById('modalSubjectInput')?.value || '';
            const code = document.getElementById('modalTicketInput')?.value || '';
            alert(`Incidencia: ${code}\n\nAsunto:\n${subj}`);
        }

        async function saveAssignModal() {
            const operatorId = document.getElementById('selectedOperatorId').value;
            const operatorName = document.getElementById('modalOperatorText').textContent;
            const areaDesignada = document.getElementById('selectedAreaValue').value;
            const prioridad = document.getElementById('selectedPriorityValue')?.value || 'P1';

            if (!operatorId) {
                alert('Por favor selecciona un operador para realizar la asignación.');
                return;
            }

            try {
                if (currentTicketCode.includes(',')) {
                    const ticketCodes = currentTicketCode.split(',').map(s => s.trim()).filter(Boolean);
                    const response = await fetch('/api/tickets/batch-assign', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ticketCodes, operatorId, areaDesignada, prioridad })
                    });
                    const result = await response.json();
                    if (result.success) {
                        closeAssignModal();
                        ticketCodes.forEach(code => {
                            updateRowDisplay(code, operatorName, true, operatorId, areaDesignada, prioridad);
                        });
                        showNotification('Asignación Masiva', `Se asignaron ${ticketCodes.length} tickets a ${operatorName}`, currentOperatorInitials);
                        document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = false);
                        const masterCb = document.getElementById('selectAllCheckbox');
                        if (masterCb) masterCb.checked = false;
                        updateSelectionCount();
                        updateKPIStats();
                    } else {
                        alert('Error: ' + result.error);
                    }
                    return;
                }

                const response = await fetch('/api/tickets/assign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ticketCode: currentTicketCode,
                        operatorId,
                        areaDesignada,
                        prioridad
                    })
                });

                const result = await response.json();
                if (result.success) {
                    closeAssignModal();
                    updateRowDisplay(currentTicketCode, operatorName, true, operatorId, areaDesignada, prioridad);
                    showNotification('Nueva Asignación', `se asignó correctamente a ${operatorName}`, currentOperatorInitials);
                    updateKPIStats();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (err) {
                console.error(err);
                alert('Error al comunicarse con el servidor.');
            }
        }

        async function unassignCurrentTicket() {
            if (!confirm(`¿Deseas desasignar el ticket ${currentTicketCode}?`)) return;

            try {
                const response = await fetch('/api/tickets/unassign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketCode: currentTicketCode })
                });

                const result = await response.json();
                if (result.success) {
                    closeAssignModal();
                    updateRowDisplay(currentTicketCode, null, false, '', 'GENERAL', 'P3');
                    showNotification('Ticket Desasignado', `${currentTicketCode} devuelto a cola general`, 'NOC');
                    updateKPIStats();
                }
            } catch (err) {
                console.error(err);
            }
        }

        // ==========================================
        // 2. Control de Nuevo Ticket
        // ==========================================
        function openNewIncidentModal() {
            const overlay = document.getElementById('newIncidentModalOverlay');
            const card = document.getElementById('newIncidentModalCard');
            document.getElementById('newIncidentForm').reset();

            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            requestAnimationFrame(() => {
                overlay.classList.remove('opacity-0', 'pointer-events-none');
                overlay.classList.add('opacity-100');
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            });
            setTimeout(() => document.getElementById('newIncSubject').focus(), 150);
        }

        function closeNewIncidentModal() {
            const overlay = document.getElementById('newIncidentModalOverlay');
            const card = document.getElementById('newIncidentModalCard');
            if (!overlay || !card) return;

            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0', 'pointer-events-none');

            setTimeout(() => {
                overlay.classList.remove('flex');
                overlay.classList.add('hidden');
            }, 200);
        }

        async function submitNewIncident(event) {
            event.preventDefault();
            const submitBtn = document.getElementById('submitNewIncidentBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Guardando...';

            const asunto = document.getElementById('newIncSubject').value;
            const descripcion = document.getElementById('newIncDescription').value;
            const areaDesignada = document.getElementById('newIncArea').value;
            const prioridad = document.getElementById('newIncPriority').value;
            const operatorId = document.getElementById('newIncOperator').value;

            try {
                const response = await fetch('/api/tickets/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        asunto,
                        descripcion,
                        areaDesignada,
                        prioridad,
                        operatorId: operatorId || null
                    })
                });

                const result = await response.json();
                if (result.success && result.ticket) {
                    closeNewIncidentModal();
                    showNotification('Ticket Creado', `Se registró ${result.ticket.codigo_incidencia} exitosamente`, 'NOC');
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    alert('Error al crear ticket: ' + (result.error || 'Desconocido'));
                }
            } catch (err) {
                console.error(err);
                alert('Error de conexión al registrar ticket');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Crear Ticket';
            }
        }

        // ==========================================
        // 3. Resolución Rápida de Tickets
        // ==========================================
        async function resolveTicketQuick(ticketCode) {
            if (!confirm(`¿Confirmas cerrar y marcar como resuelto el ticket ${ticketCode}?`)) return;

            try {
                const response = await fetch('/api/tickets/status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketCode, estado: 'CERRADO' })
                });

                const result = await response.json();
                if (result.success) {
                    const row = document.getElementById(`row-${ticketCode}`);
                    if (row) {
                        row.setAttribute('data-status', 'CERRADO');
                        const stateCol = row.querySelector('.state-col');
                        if (stateCol) {
                            stateCol.innerHTML = `
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[4px] text-[11px] font-medium" style="background-color: rgba(34, 197, 94, 0.1); color: rgb(20, 83, 45); border: 1px solid rgba(34, 197, 94, 0.2);">
                                    <span class="w-1.5 h-1.5 rounded-full" style="background-color: #22c55e;"></span>
                                    <span class="status-text">Cerrado</span>
                                </span>
                            `;
                        }
                        const timeCol = row.querySelector('.time-col span');
                        if (timeCol) timeCol.textContent = 'Resuelto';
                        const actionBtn = row.querySelector('.action-col button');
                        if (actionBtn && actionBtn.textContent.includes('Cerrar')) {
                            actionBtn.remove();
                        }
                    }
                    showNotification('Ticket Resuelto', `${ticketCode} marcado como Cerrado`, 'OK');

                    // Actualizar contadores
                    const kpiDone = document.getElementById('kpi-done');
                    if (kpiDone) kpiDone.textContent = parseInt(kpiDone.textContent || '0', 10) + 1;
                    const kpiActive = document.getElementById('kpi-active');
                    if (kpiActive) {
                        const cur = parseInt(kpiActive.textContent || '0', 10);
                        if (cur > 0) kpiActive.textContent = cur - 1;
                    }
                    updateKPIStats();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (err) {
                console.error(err);
                alert('Error al actualizar el ticket');
            }
        }

        // ==========================================
        // 4. Actualización Visual de Filas
        // ==========================================
        function updateRowDisplay(ticketCode, operatorName, isAssigned, operatorId, area, prioridad) {
            const row = document.getElementById(`row-${ticketCode}`);
            if (!row) return;

            row.setAttribute('data-status', isAssigned ? 'EN_PROGRESO' : 'NUEVO');
            const opCol = row.querySelector('.op-col .operator-label');
            const stateCol = row.querySelector('.state-col .status-text');
            const actionBtn = row.querySelector('.action-col button');
            const ticketLink = row.querySelector('a');

            if (opCol) {
                if (isAssigned) {
                    opCol.textContent = operatorName;
                    opCol.classList.remove('italic', 'text-[#8E8E93]');
                    opCol.classList.add('font-semibold', 'text-[#007AFF]');
                } else {
                    opCol.textContent = '— Sin asignar';
                    opCol.classList.add('italic', 'text-[#8E8E93]');
                    opCol.classList.remove('font-semibold', 'text-[#007AFF]');
                }
            }

            if (stateCol) {
                stateCol.textContent = isAssigned ? 'En Progreso' : 'Nuevo';
            }

            if (prioridad) {
                row.setAttribute('data-priority', prioridad);
                const prioBadge = row.querySelector('td:nth-child(3) span');
                if (prioBadge) {
                    if (prioridad === 'P1') {
                        prioBadge.style.backgroundColor = '#FFE5E5';
                        prioBadge.style.color = '#D70015';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #FF3B30;"></span> P1';
                    } else if (prioridad === 'P2') {
                        prioBadge.style.backgroundColor = '#FFF4D6';
                        prioBadge.style.color = '#B25E02';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #FFBD2E;"></span> P2';
                    } else {
                        prioBadge.style.backgroundColor = '#F2F2F7';
                        prioBadge.style.color = '#1C1C1E';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #8E8E93;"></span> P3';
                    }
                }
            }

            if (area) row.setAttribute('data-area', area);

            const currentPrio = prioridad || row.getAttribute('data-priority') || 'P1';
            const cleanSubj = (row.querySelector('.truncate')?.getAttribute('title') || row.querySelector('.truncate')?.textContent || '').replace(/'/g, "\\'");

            if (actionBtn) {
                actionBtn.textContent = 'Asignar';
                actionBtn.setAttribute('onclick', `openAssignModal('${ticketCode}', '${cleanSubj}', '${area || 'GENERAL'}', '${operatorId || ''}', '${operatorName || ''}', '${currentPrio}')`);
            }
            if (ticketLink) {
                ticketLink.setAttribute('onclick', `openAssignModal('${ticketCode}', '${cleanSubj}', '${area || 'GENERAL'}', '${operatorId || ''}', '${operatorName || ''}', '${currentPrio}')`);
            }
        }

        // ==========================================
        // 5. Notificación Toast Liquid Glass
        // ==========================================
        function showNotification(title, message, initials) {
            const notif = document.getElementById('liquidGlassNotification');
            const titleEl = document.getElementById('notifTitleText');
            const descEl = document.getElementById('notifDescriptionText');
            const badgeEl = document.getElementById('notifAvatarBadge');

            if (titleEl) titleEl.textContent = title;
            if (descEl) descEl.textContent = message;
            if (badgeEl) badgeEl.textContent = initials || 'NOC';

            notif.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
            notif.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');

            if (notifTimeout) clearTimeout(notifTimeout);
            notifTimeout = setTimeout(() => hideNotification(), 4500);
        }

        function hideNotification() {
            const notif = document.getElementById('liquidGlassNotification');
            if (!notif) return;
            notif.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
            notif.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
        }

        // ==========================================
        // 6. Filtros de Tabla (Segmented Control, Área, Prioridad, Búsqueda)
        // ==========================================
        let currentStatusFilter = 'ALL';
        let currentAreaFilter = 'ALL';
        let currentPriorityFilter = 'ALL';
        let currentSearchQuery = '';
        let dateSortAsc = false;

        function onSearchInput(val) {
            currentSearchQuery = (val || '').toLowerCase().trim();
            applyTableFilters();
        }

        function filterByStatus(statusCode, elem) {
            currentStatusFilter = statusCode;
            document.querySelectorAll('.segment-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-white', 'text-[#1C1C1E]', 'shadow-xs', 'font-semibold');
                btn.classList.add('text-[#636366]', 'font-medium');
            });
            if (elem) {
                elem.classList.add('active', 'bg-white', 'text-[#1C1C1E]', 'shadow-xs', 'font-semibold');
                elem.classList.remove('text-[#636366]', 'font-medium');
            }
            applyTableFilters();
        }

        function filterByArea(areaCode, label, elem) {
            currentAreaFilter = areaCode;
            const labelEl = document.getElementById('filterAreaText');
            if (labelEl) labelEl.textContent = label;

            document.querySelectorAll('.filter-area-item').forEach(item => {
                item.classList.remove('bg-[#007AFF]', 'text-white');
                item.classList.add('text-[#1C1C1E]');
                const check = item.querySelector('.check-icon');
                if (check) check.classList.add('hidden');
            });
            if (elem) {
                elem.classList.add('bg-[#007AFF]', 'text-white');
                elem.classList.remove('text-[#1C1C1E]');
                const check = elem.querySelector('.check-icon');
                if (check) check.classList.remove('hidden');
            }

            const details = document.getElementById('filterAreaDropdown');
            if (details) details.removeAttribute('open');
            applyTableFilters();
        }

        function filterByPriority(prioCode, label, elem) {
            currentPriorityFilter = prioCode;
            const labelEl = document.getElementById('filterPriorityText');
            if (labelEl) labelEl.textContent = label;

            document.querySelectorAll('.filter-prio-item').forEach(item => {
                item.classList.remove('bg-[#007AFF]', 'text-white');
                item.classList.add('text-[#1C1C1E]');
                const check = item.querySelector('.check-icon');
                if (check) check.classList.add('hidden');
            });
            if (elem) {
                elem.classList.add('bg-[#007AFF]', 'text-white');
                elem.classList.remove('text-[#1C1C1E]');
                const check = elem.querySelector('.check-icon');
                if (check) check.classList.remove('hidden');
            }

            const details = document.getElementById('filterPriorityDropdown');
            if (details) details.removeAttribute('open');
            applyTableFilters();
        }

        function applyTableFilters() {
            const rows = document.querySelectorAll('.ticket-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status') || 'NUEVO';
                const rowArea = row.getAttribute('data-area');
                const rowPrio = row.getAttribute('data-priority');
                const rowText = row.textContent.toLowerCase();

                const matchesStatus = (currentStatusFilter === 'ALL' || rowStatus === currentStatusFilter);
                const matchesArea = (currentAreaFilter === 'ALL' || rowArea === currentAreaFilter);
                const matchesPrio = (currentPriorityFilter === 'ALL' || rowPrio === currentPriorityFilter);
                const matchesSearch = !currentSearchQuery || rowText.includes(currentSearchQuery);

                if (matchesStatus && matchesArea && matchesPrio && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noMatch = document.getElementById('noFilterMatchRow');
            if (noMatch) noMatch.classList.toggle('hidden', visibleCount > 0);

            const counter = document.getElementById('activeTicketsCounter');
            if (counter) counter.textContent = visibleCount;
        }

        function toggleSortDate() {
            dateSortAsc = !dateSortAsc;
            const indicator = document.getElementById('dateSortIndicator');
            if (indicator) indicator.textContent = dateSortAsc ? '▲' : '▼';

            const tbody = document.getElementById('ticketTableBody');
            const rows = Array.from(tbody.querySelectorAll('.ticket-row'));

            rows.sort((a, b) => {
                const timeA = parseInt(a.getAttribute('data-date') || '0', 10);
                const timeB = parseInt(b.getAttribute('data-date') || '0', 10);
                return dateSortAsc ? timeA - timeB : timeB - timeA;
            });

            const noMatch = document.getElementById('noFilterMatchRow');
            rows.forEach(r => tbody.appendChild(r));
            if (noMatch) tbody.appendChild(noMatch);
        }

        function updateKPIStats() {
            const rows = document.querySelectorAll('.ticket-row');
            let criticalUnassigned = 0;
            rows.forEach(row => {
                const prio = row.getAttribute('data-priority');
                const status = row.getAttribute('data-status');
                const op = row.querySelector('.op-col .operator-label')?.textContent || '';
                const isUnassigned = op.includes('— Sin asignar') || !op.trim();
                if (prio === 'P1' && isUnassigned && status !== 'CERRADO') {
                    criticalUnassigned++;
                }
            });
            const critEl = document.getElementById('kpi-critical');
            if (critEl) critEl.textContent = criticalUnassigned;
        }

        // ==========================================
        // 7. Selección Múltiple y Despacho en Lote
        // ==========================================
        function updateSelectionCount() {
            const checkboxes = document.querySelectorAll('.row-checkbox:checked');
            const count = checkboxes.length;
            const badge = document.getElementById('selectionBadgeCount');
            const batchBtn = document.getElementById('batchAssignBtn');
            const batchText = document.getElementById('batchAssignBtnText');

            if (badge) badge.textContent = count;
            if (batchBtn) {
                if (count > 0) {
                    batchBtn.disabled = false;
                    batchText.textContent = `Asignar (${count}) tickets...`;
                } else {
                    batchBtn.disabled = true;
                    batchText.textContent = 'Asignar Tickets';
                }
            }
        }

        function toggleSelectAll(masterCheckbox) {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(cb => cb.checked = masterCheckbox.checked);
            updateSelectionCount();
        }

        function openBatchAssignModal() {
            const checked = document.querySelectorAll('.row-checkbox:checked');
            if (checked.length === 0) return;
            const codes = Array.from(checked).map(cb => cb.getAttribute('data-code'));
            openAssignModal(codes.join(', '), `Lote de ${codes.length} incidencias seleccionadas`, 'REDES_FTTH', '', '');
        }

        // ==========================================
        // 8. Event Listeners & Atajos de Teclado
        // ==========================================
        function handleBackdropClick(event) {
            if (event.target === document.getElementById('assignModalOverlay')) {
                closeAssignModal();
            }
        }

        function handleNewIncidentBackdropClick(event) {
            if (event.target === document.getElementById('newIncidentModalOverlay')) {
                closeNewIncidentModal();
            }
        }

        document.addEventListener('click', function(e) {
            const areaDd = document.getElementById('filterAreaDropdown');
            const prioDd = document.getElementById('filterPriorityDropdown');
            if (areaDd && !areaDd.contains(e.target)) areaDd.removeAttribute('open');
            if (prioDd && !prioDd.contains(e.target)) prioDd.removeAttribute('open');
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeAssignModal();
                closeNewIncidentModal();
                hideNotification();
            }
            // ⌘K o Ctrl+K para Búsqueda Global
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            }
            // ⌘N o Ctrl+N para Nuevo Incidente
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'n') {
                e.preventDefault();
                openNewIncidentModal();
            }
        });

        // Telemetría NOC en Vivo: variación realista de ping cada 4 segundos
        setInterval(() => {
            const pingEl = document.getElementById('telemetryPing');
            if (pingEl) {
                const randomPing = Math.floor(13 + Math.random() * 8);
                pingEl.textContent = `${randomPing}ms`;
            }
        }, 4000);
    </script>
</body>

</html>